# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your_key_from_google_ai_studio

# Model per agent (default gemini-3.8-flash)
PLANNER_MODEL=gemini-3.8-flash
RESEARCHER_MODEL=gemini-3.8-flash
DEVELOPER_MODEL=gemini-3.8-flash
CODER_MODEL=gemini-3.8-flash

# Optional tuning
# GEMINI_REASONING_EFFORT=low     # low | medium | high (3.8 Flash cannot disable thinking)
# CODER_REASONING_EFFORT=medium   # per-agent override
# LLM_TIMEOUT_SECONDS=120         # read timeout per request
